APP_NAME="Shot Creative Agent Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shot_creative
DB_USERNAME=shot_creative
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=shot-creative
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

REVERB_APP_ID=shot-creative
REVERB_APP_KEY=shot-creative-key
REVERB_APP_SECRET=shot-creative-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

AGENT_PROVIDER=mock
AGENT_MODEL=gemini-3.8-flash
JUDGE_PROVIDER=replay
JUDGE_MODEL=gemini-3.5-flash-lite
IMAGE_PROVIDER=replay
VIDEO_PROVIDER=replay
AUDIO_PROVIDER=replay
BUDGET_CAP=100
